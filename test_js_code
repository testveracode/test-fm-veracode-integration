const express = require("express");
const child_process = require("child_process");
const fs = require("fs");
const jwt = require("jsonwebtoken");
const crypto = require("crypto");

const app = express();
app.use(express.json());

// Hardcoded secrets
const DB_PASSWORD = "admin123";
const JWT_SECRET = "secret";
const API_KEY = "sk_live_123456789";

// 1. SQL Injection
app.get("/user", (req, res) => {
  const id = req.query.id;
  const query = "SELECT * FROM users WHERE id = '" + id + "'";
  res.send({ query });
});

// 2. Command Injection
app.get("/ping", (req, res) => {
  const host = req.query.host;
  child_process.exec("ping -c 1 " + host, (err, stdout) => {
    res.send(stdout);
  });
});

// 3. Path Traversal
app.get("/file", (req, res) => {
  const fileName = req.query.name;
  const content = fs.readFileSync("./files/" + fileName, "utf8");
  res.send(content);
});

// 4. Insecure JWT Verification
app.get("/verify", (req, res) => {
  const token = req.headers.authorization;
  const decoded = jwt.decode(token); // unsafe: no signature verification
  res.send(decoded);
});

// 5. Weak Crypto
app.get("/hash", (req, res) => {
  const value = req.query.value;
  const hash = crypto.createHash("md5").update(value).digest("hex");
  res.send(hash);
});

// 6. Insecure Randomness
app.get("/otp", (req, res) => {
  const otp = Math.floor(Math.random() * 1000000);
  res.send({ otp });
});

// 7. XSS
app.get("/search", (req, res) => {
  const q = req.query.q;
  res.send(`<html><body>Search result for: ${q}</body></html>`);
});

